        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"system\": {{ JSON.stringify($env.SDR_SYSTEM_PROMPT + '\\n\\n--- REGRAS DE FOLLOW-UP ---\\n' + $env.SDR_FOLLOWUP_RULES) }},\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Lead respondeu. Contexto + histórico:\\n' + JSON.stringify($json, null, 2) + '\\n\\nGere a próxima resposta seguindo o system prompt e as regras de follow-up. Retorne APENAS o JSON especificado.') }} }\n  ]\n}",
        "options": {}
