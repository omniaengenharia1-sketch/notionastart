    {
      "parameters": {
        "jsCode": "const lead = $input.item.json;\nconst inbound = $('Parse Z-API + identifica').item.json;\nif (!lead || !lead.id) {\n  // Lead não está no Notion — cria entrada nova\n  return { json: { isNewLead: true, fromNumber: inbound.fromNumber, contactName: inbound.contactName, messageText: inbound.messageText } };\n}\nconst props = lead.property || lead.properties || {};\nconst getText = (key) => {\n  const p = props[key];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  if (p.rich_text) return p.rich_text.map(t => t.plain_text).join('');\n  if (p.select) return p.select?.name || '';\n  if (p.phone_number) return p.phone_number;\n  if (p.url) return p.url;\n  return '';\n};\nconst historicoExistente = getText('Histórico');\nconst now = new Date().toISOString().replace('T', ' ').slice(0, 16);\nconst novaLinha = `[${now} LEAD] ${inbound.messageText}`;\nconst historicoAtualizado = historicoExistente ? `${historicoExistente}\\n${novaLinha}` : novaLinha;\nreturn { json: {\n  isNewLead: false,\n  lead_id: lead.id,\n  nome: getText('Nome'),\n  empresa: getText('Empresa'),\n  cargo: getText('Cargo'),\n  whatsapp: getText('WhatsApp'),\n  gatilho: getText('Gatilho de prospecção'),\n  setor: getText('Setor'),\n  instagram: getText('Instagram'),\n  site: getText('Site da empresa'),\n  ultima_msg_lead: inbound.messageText,\n  historico: historicoAtualizado,\n  is_first_touch: false\n} };"
      },
