      "name": "Acha pendente (aprovar)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1120, 100],
      "credentials": { "notionApi": { "id": "notion-cred", "name": "Notion API" } }
