{
  "name": "SDR Astart — 2. Callback Z-API (aprovação OU resposta de lead)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zapi-callback",
        "responseMode": "onReceived",
        "responseData": "noData",
        "options": {}
      },
      "id": "webhook-zapi",
      "name": "Webhook Z-API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse Z-API webhook (formato 'Ao receber'). Identifica origem (operador x lead) e ação.\nconst body = $input.item.json.body || $input.item.json;\n\n// Ignora: status updates, mensagens enviadas por nós (fromMe), grupos\nif (body.fromMe === true || body.isGroup === true || body.type !== 'ReceivedCallback') {\n  return { json: { skip: true, reason: 'fromMe/group/notReceived' } };\n}\n\nconst fromNumber = String(body.phone || '').replace(/\\D/g, '');\nconst contactName = body.senderName || body.chatName || null;\nconst messageText = body.text?.message || body.image?.caption || body.audio?.caption || '';\nconst messageId = body.messageId;\n\nif (!fromNumber || !messageText) {\n  return { json: { skip: true, reason: 'noNumberOrText' } };\n}\n\nconst operatorNumber = String($env.OPERATOR_PERSONAL_NUMBER).replace(/\\D/g, '');\nconst isFromOperator = fromNumber === operatorNumber;\n\n// Detecta comandos do operador\nlet command = null;\nlet commandPayload = null;\nif (isFromOperator) {\n  const trimmed = messageText.trim();\n  const upper = trimmed.toUpperCase();\n  if (upper === 'APROVAR' || upper === 'APROVA' || upper === 'OK' || upper === '✅') {\n    command = 'approve';\n  } else if (upper === 'PULAR' || upper === 'PULA' || upper === 'SKIP' || upper === '❌') {\n    command = 'skip';\n  } else if (upper.startsWith('EDITAR:') || upper.startsWith('EDITAR ')) {\n    command = 'edit';\n    commandPayload = trimmed.replace(/^EDITAR[:\\s]+/i, '').trim();\n  } else {\n    // Operador mandou texto livre — ignora (provavelmente conversa pessoal)\n    return { json: { skip: true, reason: 'operatorFreeText' } };\n  }\n}\n\nconst route = isFromOperator ? command : 'lead_reply';\n\nreturn {\n  json: {\n    skip: false,\n    fromNumber,\n    contactName,\n    messageText,\n    messageId,\n    isFromOperator,\n    command,\n    commandPayload,\n    route\n  }\n};"
      },
