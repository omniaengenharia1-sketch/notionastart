{
  "name": "SDR Astart — 2. Callback Unificado (aprovação OU resposta de lead)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-callback",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-unified",
      "name": "Webhook Meta (SDR)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse universal: extrai a mensagem e decide se é do operador ou de um lead\nconst body = $input.item.json.body || $input.item.json;\nconst entries = body.entry || [];\n\nlet fromNumber = null;\nlet messageType = null;\nlet messageText = null;\nlet buttonAction = null;\nlet buttonLeadId = null;\nlet contactName = null;\n\nfor (const entry of entries) {\n  for (const change of (entry.changes || [])) {\n    const value = change.value || {};\n    const contacts = value.contacts || [];\n    if (contacts[0]) contactName = contacts[0].profile?.name || null;\n    for (const msg of (value.messages || [])) {\n      fromNumber = msg.from;\n      messageType = msg.type;\n      if (msg.type === 'text') {\n        messageText = msg.text?.body || '';\n      } else if (msg.type === 'interactive' && msg.interactive?.button_reply) {\n        const buttonId = msg.interactive.button_reply.id;\n        const [act, ...idParts] = buttonId.split('_');\n        buttonAction = act; // approve | edit | skip\n        buttonLeadId = idParts.join('_');\n        messageText = msg.interactive.button_reply.title;\n      } else {\n        messageText = `[${msg.type}]`;\n      }\n    }\n  }\n}\n\nif (!fromNumber) {\n  // Status update (delivered/read) — ignora\n  return { json: { skip: true } };\n}\n\nconst operatorNumber = $env.OPERATOR_PERSONAL_NUMBER;\nconst isFromOperator = fromNumber === operatorNumber;\n\nreturn {\n  json: {\n    skip: false,\n    fromNumber,\n    contactName,\n    messageType,\n    messageText,\n    buttonAction,\n    buttonLeadId,\n    isFromOperator,\n    route: isFromOperator ? (buttonAction || 'edit_text') : 'lead_reply'\n  }\n};"
      },
      "id": "parse-universal",
      "name": "Parse + identifica remetente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
