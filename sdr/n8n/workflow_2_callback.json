      "parameters": {
        "jsCode": "const claudeResp = $input.item.json;\nconst ctx = $('Monta contexto + histórico').item.json;\nlet parsed;\ntry {\n  const text = claudeResp.content[0].text.trim();\n  const cleaned = text.replace(/^```json\\s*/i, '').replace(/```\\s*$/, '');\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { mensagem_proposta: '[ERRO de parsing — revisar]', raciocinio: 'Falha no parsing: ' + e.message, score_sugerido: '🟡 Warm', proxima_etapa_sugerida: 'Em conversa', alerta_humano: 'Claude retornou JSON inválido em follow-up' };\n}\nreturn { json: { ...ctx, ...parsed } };"
      },
