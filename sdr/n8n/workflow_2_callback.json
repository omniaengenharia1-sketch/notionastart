            { "operation": "equal", "value2": "skip", "output": 1 },
            { "operation": "equal", "value2": "edit", "output": 2 },
            { "operation": "equal", "value2": "edit_text", "output": 3 },
            { "operation": "equal", "value2": "lead_reply", "output": 4 }
          ]
        },
        "fallbackOutput": 5
      },
