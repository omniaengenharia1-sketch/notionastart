      "name": "Notion: pega lead (aprovar)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1120, 100],
      "credentials": { "notionApi": { "id": "notion-cred", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.item.json;\nconst props = lead.property || lead.properties || {};\nconst getText = (key) => {\n  const p = props[key];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  if (p.rich_text) return p.rich_text.map(t => t.plain_text).join('');\n  if (p.phone_number) return p.phone_number;\n  return '';\n};\nconst whatsapp = getText('WhatsApp').replace(/\\D/g, '');\nconst mensagem = getText('Mensagem proposta');\nconst historicoExistente = getText('Histórico');\nconst now = new Date().toISOString().replace('T', ' ').slice(0, 16);\nconst novaLinha = `[${now} SDR] ${mensagem}`;\nconst historicoAtualizado = historicoExistente ? `${historicoExistente}\\n${novaLinha}` : novaLinha;\nreturn { json: { lead_id: lead.id, whatsapp, mensagem, historicoAtualizado } };"
      },
