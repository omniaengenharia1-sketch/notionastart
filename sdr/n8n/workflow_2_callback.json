    {
      "parameters": {
        "jsCode": "const lead = $input.item.json;\nconst inbound = $('Parse + identifica remetente').item.json;\nconst props = lead.property || lead.properties || {};\nconst getText = (key) => {\n  const p = props[key];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  if (p.rich_text) return p.rich_text.map(t => t.plain_text).join('');\n  if (p.select) return p.select?.name || '';\n  if (p.phone_number) return p.phone_number;\n  if (p.url) return p.url;\n  return '';\n};\nconst historicoExistente = getText('Histórico');\nconst now = new Date().toISOString().replace('T', ' ').slice(0, 16);\nconst novaLinha = `[${now} LEAD] ${inbound.messageText}`;\nconst historicoAtualizado = historicoExistente ? `${historicoExistente}\\n${novaLinha}` : novaLinha;\nreturn { json: { lead_id: lead.id, nome: getText('Nome'), empresa: getText('Empresa'), cargo: getText('Cargo'), whatsapp: getText('WhatsApp'), gatilho: getText('Gatilho de prospecção'), setor: getText('Setor'), instagram: getText('Instagram'), site: getText('Site da empresa'), ultima_msg_lead: inbound.messageText, historico: historicoAtualizado, is_first_touch: false } };"
      },
