{
  "name": "SDR Astart — 2. Approval (recebe sua aprovação e envia)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-ops-callback",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-ops",
      "name": "Webhook Ops (Meta)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extrai a ação clicada pelo operador no botão interativo do WhatsApp Ops\nconst body = $input.item.json.body || $input.item.json;\nconst entries = body.entry || [];\n\nlet action = null;\nlet leadId = null;\nlet textReply = null;\nlet fromOperator = null;\n\nfor (const entry of entries) {\n  for (const change of (entry.changes || [])) {\n    const value = change.value || {};\n    for (const msg of (value.messages || [])) {\n      fromOperator = msg.from;\n      if (msg.type === 'interactive' && msg.interactive?.button_reply) {\n        const buttonId = msg.interactive.button_reply.id;\n        const [act, ...idParts] = buttonId.split('_');\n        action = act; // approve | edit | skip\n        leadId = idParts.join('_');\n      } else if (msg.type === 'text') {\n        // texto livre: tratar como edição se vier após botão Editar (precisa de state)\n        textReply = msg.text?.body || '';\n      }\n    }\n  }\n}\n\nreturn {\n  json: { action, leadId, textReply, fromOperator, raw: body }\n};"
      },
      "id": "parse-callback",
      "name": "Parse callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.action }}",
        "rules": {
          "rules": [
            { "operation": "equal", "value2": "approve", "output": 0 },
            { "operation": "equal", "value2": "edit", "output": 1 },
            { "operation": "equal", "value2": "skip", "output": 2 }
          ]
        },
        "fallbackOutput": 3
      },
      "id": "switch-action",
      "name": "Roteia ação",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "get",
        "pageId": "={{ $json.leadId }}"
      },
      "id": "notion-fetch-lead",
      "name": "Notion: pega lead",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [900, 200],
      "credentials": {
        "notionApi": { "id": "notion-cred", "name": "Notion API" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extrai whatsapp + mensagem proposta do lead, e decide se usa template ou texto livre\nconst lead = $input.item.json;\nconst props = lead.property || lead.properties || {};\n\nconst getText = (key) => {\n  const p = props[key];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  if (p.rich_text) return p.rich_text.map(t => t.plain_text).join('');\n  if (p.phone_number) return p.phone_number;\n  return '';\n};\n\nconst whatsapp = getText('WhatsApp').replace(/\\D/g, '');\nconst mensagem = getText('Mensagem proposta');\nconst historico = getText('Histórico');\nconst is_first_touch = !historico;\n\nreturn {\n  json: {\n    lead_id: lead.id,\n    whatsapp,\n    mensagem,\n    is_first_touch\n  }\n};"
      },
      "id": "prepare-send",
      "name": "Prepara envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_SDR_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WA_SDR_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{ $json.whatsapp }}\",\n  \"type\": \"text\",\n  \"text\": { \"preview_url\": false, \"body\": {{ JSON.stringify($json.mensagem) }} }\n}",
        "options": {}
      },
      "id": "wa-send-lead",
      "name": "SDR → Lead: envia msg",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": "={{ $('Prepara envio').item.json.lead_id }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Etapa|status", "statusValue": "Enviada" },
            { "key": "Mensagem aprovada|rich_text", "textContent": "={{ $('Prepara envio').item.json.mensagem }}" },
            { "key": "Última interação em|date", "date": "={{ $now.toISO() }}" },
            { "key": "Histórico|rich_text", "textContent": "=[{{ $now.format('yyyy-MM-dd HH:mm') }} SDR] {{ $('Prepara envio').item.json.mensagem }}" }
          ]
        }
      },
      "id": "notion-mark-sent",
      "name": "Notion: marca como enviada",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1560, 200],
      "credentials": {
        "notionApi": { "id": "notion-cred", "name": "Notion API" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_OPS_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WA_OPS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.OPERATOR_PERSONAL_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"✅ Enviado pro lead. Vou te avisar quando responder.\" }\n}",
        "options": {}
      },
      "id": "wa-ops-confirm",
      "name": "Ops: confirma envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.WA_OPS_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.WA_OPS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.OPERATOR_PERSONAL_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": \"✏️ Manda aqui o novo texto que você quer enviar pro lead (esta resposta vai virar a mensagem aprovada).\\n\\nLead ID: {{ $json.leadId }}\" }\n}",
        "options": {}
      },
      "id": "wa-ops-ask-edit",
      "name": "Ops: pede texto editado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": "={{ $json.leadId }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Etapa|status", "statusValue": "Aguardando edição" }
          ]
        }
      },
      "id": "notion-mark-editing",
      "name": "Notion: aguardando edição",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1120, 400],
      "credentials": {
        "notionApi": { "id": "notion-cred", "name": "Notion API" }
      }
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": "={{ $json.leadId }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Etapa|status", "statusValue": "Descartado" },
            { "key": "Motivo desqualificação|rich_text", "textContent": "Operador pulou na aprovação" }
          ]
        }
      },
      "id": "notion-mark-skipped",
      "name": "Notion: descartado",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [900, 580],
      "credentials": {
        "notionApi": { "id": "notion-cred", "name": "Notion API" }
      }
    }
  ],
  "connections": {
